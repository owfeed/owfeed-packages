# A published signing key cannot be revoked: apk has no CRL, no expiry, and no way
# to say a key is dead.
*.pem
*.key
*.sec

# Public halves are the point of keys/ and must be committed. The exception is
# deliberately narrow: only *.pub.pem, so a private key dropped there by accident as
# keys/<name>.pem stays ignored by the rule above.
!keys/*.pub.pem

dist/
out/
staging/
owfeed
.shim/

# The opkg signing key is a secret too.
*.sec
